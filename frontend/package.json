{
  "name": "dgov-web",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "Government Template Platform V3.0 — Vite + React SPA (nginx-ээр статикаар үйлчлэгдэж, /api/* нь api контейнер руу проксилогдоно).",
  "scripts": {
    "dev": "vite --port 3000",
    "build": "tsc --noEmit && vite build",
