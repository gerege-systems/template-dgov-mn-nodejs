# docker-compose-ийн interpolation-д зориулсан утгууд.
# Хуулж `.env` болго (gitignored) ба бодит нууц утгуудаа бөглө:
#   cp .env.example .env
#
# Backend-ийн ӨӨРИЙН тохиргоо нь тусдаа файлд байна — backend/.env.example-ийг
# хуулж `backend.env` болго (api + migrate контейнерт /app/.env болж mount хийгдэнэ).

# --- Postgres / Redis ---
# POSTGRES_USER нь superuser — ЗӨВХӨН migrate ашиглана (CREATE EXTENSION, RLS DDL).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_DB_SUPERUSER
POSTGRES_DB=gerege_template
# api-ийн холбогдох хамгийн бага эрхтэй role. Хоосон data volume-ийн ЭХНИЙ init
# үед backend/deploy/initdb/10-create-app-user.sh нь үүнийг үүсгэнэ.
# Superuser-ээр холбогдвол Postgres RLS-ийг ЧИМЭЭГҮЙ алгасах тул энэ нь заавал.
APP_DB_USER=app_user
APP_DB_PASSWORD=CHANGE_ME_APP_DB
APP_DB_DSN=postgres://app_user:CHANGE_ME_APP_DB@db:5432/gerege_template?sslmode=disable
REDIS_PASS=CHANGE_ME_REDIS

# --- Апп / origin ---
# Яг нийтийн origin (CSRF origin шалгалтад хэрэглэгдэнэ).
APP_ORIGIN=https://node.template.dgov.mn
# nginx проксилдог loopback портууд. Host дээр СУЛ байгаа портыг сонго — нэг сервер
# дээр платформын хэд хэдэн deployment зэрэг ажиллаж байж болно.
WEB_PORT=3012
API_PORT=8085

# --- Web давхаргын хэрэглэдэг OAuth client ID/secret ---
# Хоосон бол тухайн товч/карт inert ("тохируулаагүй") төлөвтэй байна.
# GOOGLE_CLIENT_ID нь нууц биш (browser-ийн consent URL-д орно) — client secret нь
# backend.env-д (server талын код exchange).
GOOGLE_CLIENT_ID=
# Гуравдагч интеграцийн OAuth — token exchange нь web давхаргад хийгддэг тул
# secret ч энд орно. redirect_uri = ${APP_ORIGIN}/api/integrations/<provider>/callback
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
GOOGLE_MEET_CLIENT_ID=
GOOGLE_MEET_CLIENT_SECRET=
