{
  "name": "template-dgov-api",
  "version": "3.0.0",
  "private": true,
  "description": "Government Template Platform V3.0 — Node.js API (Clean Architecture, Express 5 + pg + Redis)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/cmd/api/main.ts",
    "start": "node dist/cmd/api/main.js",
    "migrate": "tsx src/cmd/migration/main.ts",
    "migrate:prod": "node dist/cmd/migration/main.js",
    "healthcheck": "node dist/cmd/healthcheck/main.js",
    "lint": "eslint src --max-warnings 0",
    "fmt": "prettier --write \"src/**/*.ts\"",
    "fmt:check": "prettier --check \"src/**/*.ts\"",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "openapi": "tsx src/cmd/openapi/main.ts",
    "pre-push": "npm run fmt:check && npm run lint && npm run typecheck && npm test && npm run openapi -- --check && npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.52.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.53.0",
    "@opentelemetry/sdk-node": "^0.53.0",
    "bcryptjs": "^2.4.3",
    "cookie": "^1.0.2",
    "express": "^5.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "node-forge": "^1.3.1",
    "otplib": "^12.0.1",
    "pdf-lib": "^1.17.1",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "prom-client": "^15.1.3",
    "ssh2-sftp-client": "^11.0.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/node-forge": "^1.3.11",
    "@types/pg": "^8.11.10",
    "@types/ssh2-sftp-client": "^9.0.6",
    "@types/swagger-ui-express": "^4.1.7",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "testcontainers": "^10.16.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.21.5": true,
    "protobufjs@7.6.5": true
  }
}
