# Government Template Platform V3.0 — Node.js API-ийн тохиргоо.
#
# Энэ файлыг repo-ийн root дахь `backend.env` болгон хуулж (gitignored), бодит
# нууц утгуудаа бөглөнө. docker compose нь түүнийг api + migrate контейнерт
# /app/.env болгон mount хийдэг (config loader нь CWD-ийн .env-г уншина).
# DB/redis host нь compose-ийн үйлчилгээний нэрийг (db, redis) хэрэглэнэ.
#
# process.env нь .env файлыг ДАРНА (12-factor: орчин тэргүүн эрхтэй).

PORT=8080
# development = дотоод docker DB-д TLS байхгүй тул verify-full guard алгасна.
ENVIRONMENT=development
DEBUG=false
ALLOWED_ORIGINS=https://node.template.dgov.mn

# === Өгөгдлийн сан ===
DB_POSTGRE_DRIVER=postgres
DB_POSTGRE_DSN=postgres://gerege:CHANGE_ME_DB@db:5432/gerege_template?sslmode=disable
# production-д ЗААВАЛ sslmode=verify-full (эсвэл дотоод сүлжээнд verify-ca).
DB_POSTGRE_URL=postgres://db:5432/gerege_template?sslmode=verify-full
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFE_MINS=15

# === JWT ===
# JWT_SECRET нь дор хаяж 32 тэмдэгт (HS256 = 256 бит энтропи).
# generate: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_32_PLUS_CHAR_SECRET
# Access токены нас (цаг, 1..24). Богино байх ёстой — урт сессийг refresh барина.
JWT_EXPIRED=5
# Refresh токены нас (хоног, 1..365).
JWT_REFRESH_EXPIRED=7
JWT_ISSUER=node.template.dgov.mn

OTP_MAX_ATTEMPTS=5

# bcrypt-ийн cost (10..31). 12 ≈ 2026 оны CPU дээр 100–200 мс.
BCRYPT_COST=12

# === Redis ===
REDIS_HOST=redis:6379
REDIS_PASS=CHANGE_ME_REDIS
# Кэшийн өгөгдмөл TTL (минут).
REDIS_EXPIRED=5

# === Observability ===
# OTEL_EXPORTER: хоосон = tracing идэвхгүй; "stdout" = console; "otlp" =
# OTEL_EXPORTER_OTLP_ENDPOINT рүү (collector / Jaeger / Tempo / Honeycomb).
OTEL_EXPORTER=
OTEL_SAMPLE_RATIO=1.0
# production-д /metrics ба /swagger/doc.json-г хамгаалах bearer token. Хоосон бол
# эдгээр endpoint production-д 404 (бүрэн хаалттай). development-д нээлттэй.
OBSERVABILITY_TOKEN=

# Итгэмжит урвуу proxy-гийн IP/CIDR (CSV). Хоосон = X-Forwarded-For-д итгэхгүй
# (peer IP хэрэглэнэ) — rate-limit/audit spoofing-ийн эсрэг fail-safe.
# АНХААР: nginx → web → api топологид api нь зөвхөн web/nginx-ийн IP-г хардаг тул
# энийг тохируулаагүй бол IP тус бүрийн rate limit НЭГ л bucket болж хумигдана.
# Жишээ: TRUSTED_PROXIES=172.16.0.0/12,127.0.0.1
TRUSTED_PROXIES=

# === GeregeCloud Verify (email/SMS OTP) ===
# Бүх OTP (бүртгэл баталгаажуулах + нууц үг сэргээх) энэ үйлчилгээгээр явна;
# SMTP огт ашиглахгүй. production-д VERIFY_API_KEY заавал (хоосон бол boot унана).
VERIFY_API_BASE=https://verify.gecloud.mn/v1
VERIFY_API_KEY=CHANGE_ME_GECLOUD_VERIFY_KEY
VERIFY_CHANNEL=email

# === eID (eidmongolia.mn) — энэ апп нь Relying Party ===
# "Login with eID" нь цорын ганц нэвтрэх арга. EID_CALLBACK_URL нь IdP-ийн
# allowlist-д бүртгэгдсэн URL байх ёстой.
EID_BASE_URL=https://eidmongolia.mn/v3
EID_RP_UUID=
EID_RP_NAME=template-node-web
EID_RP_SECRET=
# ADVANCED = хамгийн нийцтэй (ADVANCED/QUALIFIED/QSCD бүгдийг хүлээн авна).
EID_CERT_LEVEL=ADVANCED
EID_CALLBACK_URL=https://node.template.dgov.mn/login/verify
EID_DISPLAY_TEXT=node.template.dgov.mn
# 3 дагч RP dan-аар ДАМЖИН eID гарын үсэг зурах shared token. Хоосон = relay идэвхгүй.
SIGN_RELAY_TOKEN=

# === PDF гарын үсэг (PAdES) ===
# Серверийн БАЙНГЫН Document-Signer гэрчилгээ + ECDSA түлхүүрийн PEM зам.
# production-д ЗААВАЛ (fail-closed): эфемер self-signed key нь reproducible/
# verifiable/revocable бус. development-д хоосон бол dev self-signed руу шилжинэ.
SIGN_SIGNER_CERT_FILE=
SIGN_SIGNER_KEY_FILE=

# === Google OAuth (Google account-ийг eID хэрэглэгчид холбох) ===
# Хоосон бол Google login идэвхгүй (feature fail-closed). CLIENT_SECRET нь НУУЦ,
# зөвхөн api контейнерт үлдэнэ (browser-т хэзээ ч гарахгүй).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# === Gemini AI pipeline (/api/v1/ai/*) ===
# SDK-гүй, REST-ээр шууд дуудна. Хоосон бол AI endpoint 500 буцаана (template нь
# AI-гүйгээр boot хийгдэх боломжтой хэвээр).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_VOICE=
GEMINI_API_BASE=
# AI туслахын хамрах хүрээний env fallback — DB-ийн 'scope' prompt давхарга
# хоосон/уншигдахгүй үед хэрэглэгдэнэ.
AI_SCOPE_PROMPT=

# === XYP (xyp.dgov.mn) — байгууллагын лавлагаа ===
# HTTP Basic Auth. Креденшлгүй бол eID байгууллага холбох функц идэвхгүй.
XYP_API_BASE=https://xyp.dgov.mn
XYP_CLIENT_ID=
XYP_CLIENT_SECRET=

# === Gerege Core (core.gerege.mn) — user/organization find ===
CORE_API_BASE=https://core.gerege.mn
CORE_API_TOKEN=

# === Bootstrap ===
# Тохируулсан бол boot үед энэ и-мэйлтэй хэрэглэгчийг (байгаа тохиолдолд)
# super admin болгож ахиулна. Хэрэглэгч эхлээд бүртгүүлсэн байх ёстой.
SUPERADMIN_EMAIL=

# INTEGRATION_ENC_KEY — superadmin MFA-ийн TOTP secret болон integrations OAuth
# токеныг AES-256-GCM-ээр шифрлэх түлхүүр. SHA-256-аар 32 байт болгодог тул дурын
# урттай байж болно. НЭГЭНТ ТАВЬСАН ТҮЛХҮҮРИЙГ ХЭЗЭЭ Ч СОЛИХГҮЙ — соливол
# өмнөх шифрлэсэн бүх өгөгдөл эвдэрнэ. generate: openssl rand -base64 48
INTEGRATION_ENC_KEY=

# === Government SSO (sso.dgov.mn, OIDC) — энэ апп нь RELYING PARTY ===
# CLIENT_ID/SECRET-ийг sso.dgov.mn дээр OAuth2 client болгож бүртгүүлж авна;
# REDIRECT_URI нь тэр client-д бүртгэсэн callback-тай ЯГ таарна.
SSO_ISSUER=https://sso.dgov.mn
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI=https://node.template.dgov.mn/sso/callback
SSO_SCOPE=openid profile email
# Mobile (iOS/Android) PKCE public client_id.
SSO_NATIVE_CLIENT_ID=template-dgov-mn-nodejs-ios
# Тохируулбал иргэний PKI самбар (summary/certificates/devices/activity) нь шууд
# eidmongolia-ий оронд SSO proxy-гоор дамжина — энэ апп-д eID RP creds
# шаардахгүй. offline_access scope + хадгалагдсан SSO refresh token шаардана.
SSO_EID_PROXY_BASE_URL=

# === OIDC PROVIDER тал (энэ платформ ӨӨРӨӨ OIDC provider) ===
# Ory Hydra-г ХАССАН — provider-ийг backend өөрөө (usecases/oidc + oauth_clients
# хүснэгт) хангана. OAUTH_ISSUER + SSO_STATE_KEY бүрдсэн үед provider урсгал
# идэвхжинэ. id_token-ий гарын үсэгт INTEGRATION_ENC_KEY шаардлагатай.
#
# OAUTH_ISSUER — OIDC issuer. Discovery, id_token-ий `iss` болон бүх endpoint URL
# үүнээс гарна. Сүүлийн slash-гүй.
OAUTH_ISSUER=https://node.template.dgov.mn
# SSO_STATE_KEY — login/consent урсгалын transient state HMAC түлхүүр (>=32 байт).
# generate: openssl rand -base64 48
SSO_STATE_KEY=CHANGE_ME_TO_A_RANDOM_32_PLUS_BYTE_KEY
# consent UI-г алгасах эхний талын client_id-ууд (CSV).
SSO_FIRSTPARTY_CLIENTS=
# /admin гадаргууг баталгаажуулах bootstrap API key(s), CSV (SHA-256 hash-аар
# тааруулна; хадгалагдахгүй).
SSO_ADMIN_API_KEYS=
# superadmin эрхтэй eid_sub-ууд (CSV).
SSO_ADMIN_SUBS=

# === Relay (platform-хоорондын хүсэлт дамжуулах) ===
# demo simulator: доод platform-уудын нэрийн өмнөөс хариу үүсгэж SLA самбарыг
# өөрөө хөдөлгөнө. Production-д унтраа (false) — бодит platform-ууд callback хийнэ.
RELAY_DEMO_MODE=true

# === Gerege Space (апп-ын өөрийн SFTP хадгалалт) ===
# Хэрэглэгч бүрт QUOTA_BYTES зай олгож, файлыг BASE_PATH/users/<userID>/ дор
# хадгална. PASSWORD нь НУУЦ. Хоосон бол feature идэвхгүй.
GSPACE_HOST=
GSPACE_PORT=22
GSPACE_USER=
GSPACE_PASSWORD=
GSPACE_BASE_PATH=gerege-space
GSPACE_QUOTA_BYTES=2097152
# SFTP host-ийн нийтийн түлхүүр (known_hosts мөрийн формат,
# ж: "ssh-ed25519 AAAAC3Nza..."). Тохируулбал host key-г баталгаажуулж MITM-ээс
# хамгаална. PRODUCTION-Д ЗААВАЛ — эс бөгөөс gspace холболт fail-closed алдана.
GSPACE_HOST_KEY=
